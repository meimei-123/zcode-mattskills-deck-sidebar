/* ---- 详情视图(工单 05,上游 IssueDetail 的 M1 子集) ---- */
.ms-topbar {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: baseline;
  gap: 8px;
  overflow: hidden;
  white-space: nowrap;
  background: var(--ms-bg);
  padding: 6px 0;
  border-bottom: 1px solid var(--ms-border);
}
.ms-back {
  flex: none;
  font: inherit;
  font-size: 12px;
  color: var(--ms-accent);
  background: transparent;
  border: 1px solid var(--ms-border);
  border-radius: 6px;
  padding: 2px 8px;
  cursor: pointer;
}
.ms-back:hover {
  border-color: var(--ms-accent);
}
/* 折叠元素:溢出裁切交给阶梯逐字裁(不设元素级 max-width,唯一裁切机制就是折叠阶梯) */
.ms-topbar-num {
  flex: none;
  overflow: hidden;
  font-family: var(--ms-num-font);
  font-size: 11px;
  color: var(--ms-accent);
}
.ms-topbar-title {
  flex: none;
  min-width: 0;
  overflow: hidden;
  font-size: 13px;
  font-weight: 600;
  color: #e8eaee;
}
.ms-detail-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: 10px;
}
.ms-detail-title {
  min-width: 0;
  font-size: 14px;
  font-weight: 600;
  color: #e8eaee;
  overflow-wrap: anywhere;
}
.ms-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
}
.ms-meta .ms-state-chip {
  font-size: 10px;
  line-height: 1.5;
  padding: 1px 8px;
  border-radius: var(--ms-chip-radius);
}
.ms-meta .ms-chip-open {
  color: var(--ms-ok);
  background: rgba(74, 222, 128, 0.12);
}
.ms-meta .ms-chip-closed {
  color: var(--ms-closed-ink);
  background: rgba(139, 139, 149, 0.12);
}
.ms-assignee {
  font-size: 10px;
  line-height: 1.5;
  padding: 1px 8px;
  border-radius: var(--ms-chip-radius);
  color: #58a6ff;
  background: rgba(88, 166, 255, 0.12);
}
.ms-meta-date {
  font-size: 11px;
  color: var(--ms-ink-faint);
  white-space: nowrap;
}
.ms-body-sec {
  margin-top: 10px;
  padding: 8px 0;
  border-top: 1px solid var(--ms-border);
  border-bottom: 1px solid var(--ms-border);
}
.ms-sec-title {
  font-size: 11px;
  color: var(--ms-ink-dim);
  margin-bottom: 6px;
}
.ms-body {
  font-size: 12px;
  line-height: 1.6;
}
.ms-body-loading {
  color: var(--ms-ink-dim);
}
.ms-body-empty {
  color: var(--ms-ink-faint);
}
.ms-body-error-title {
  color: var(--ms-bad);
  font-weight: 600;
}
.ms-retry {
  margin-top: 6px;
  font: inherit;
  font-size: 12px;
  color: #fff;
  background: var(--ms-bad);
  border: none;
  border-radius: 6px;
  padding: 3px 12px;
  cursor: pointer;
}
/* markdown 基础渲染:标题/列表/代码块/粗斜体 */
.ms-md-p {
  margin: 0 0 6px;
  white-space: pre-wrap;
}
.ms-md-h {
  margin: 10px 0 4px;
  font-size: 13px;
  font-weight: 600;
  color: #e8eaee;
}
.ms-md-list {
  margin: 0 0 6px;
  padding-left: 20px;
}
.ms-md-pre {
  margin: 0 0 6px;
  padding: 8px 10px;
  background: #1d232d;
  border: 1px solid var(--ms-border);
  border-radius: 6px;
  overflow-x: auto;
}
.ms-md-pre code {
  font-family: var(--ms-num-font);
  font-size: 12px;
}
.ms-body strong {
  font-weight: 600;
  color: #e8eaee;
}
.ms-body em {
  font-style: italic;
}
/* 评论时间线 */
.ms-comments {
  margin-top: 10px;
}
.ms-comments-title {
  font-size: 11px;
  color: var(--ms-ink-dim);
  margin-bottom: 6px;
}
.ms-cmt-item {
  padding: 6px 8px;
  background: rgba(255, 255, 255, 0.02);
  border-radius: 6px;
  margin-bottom: 6px;
}
.ms-cmt-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 2px;
}
.ms-cmt-login {
  font-size: 12px;
  font-weight: 600;
  color: #58a6ff;
}
.ms-cmt-date {
  font-size: 11px;
  color: var(--ms-ink-faint);
}
.ms-cmt-body {
  font-size: 12px;
  line-height: 1.5;
}
.ms-cmt-more {
  font: inherit;
  font-size: 11px;
  color: var(--ms-ink-dim);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--ms-chip-radius);
  padding: 2px 10px;
  cursor: pointer;
}
/* 底部只读提示 */
.ms-readonly {
  margin-top: 2px;
  text-align: right;
  font-size: 10px;
  color: var(--ms-ink-faint);
}
